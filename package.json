{
  "name": "dsh-usage-center",
  "version": "0.4.1",
  "description": "Native DSH settings page for daily provider usage, subscription quotas, and API price estimates.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tieboyh/dsh-usage-center.git"
  },
  "homepage": "https://github.com/Tieboyh/dsh-usage-center#readme",
  "bugs": "https://github.com/Tieboyh/dsh-usage-center/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "docs/images", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/index.js && node --check src/usage.js && node --check src/pricing.js && node --check src/accounts.js && node --check src/snapshot.js && node --test",
    "prepack": "npm run check && npm run build"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-cordis",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "guided",
      "adapter": "third-party",
      "failurePolicy": "manual",
      "touchesCurrentBeforeActivation": true
    },
    "lifecycle": {
      "activation": "restart-host",
      "dispose": "unknown"
    },
    "permissions": [
      "credentials:read",
      "environment:read",
      "filesystem:read",
      "filesystem:write",
      "locale:register",
      "network:outbound",
      "sessions:read",
      "settings:register",
      "webserver:register"
    ],
    "capability": {
      "id": "usage-center.ui",
      "kind": "ui",
      "invocation": "Open DSH Settings, select Usage & Cost, and refresh the overview.",
      "expected": "The page displays locally aggregated daily token usage and available provider balance or quota states, with API-equivalent estimates, without exposing credentials."
    },
    "evidence": {
      "install": "README.md",
      "failureIsolation": null,
      "hotReload": "README.md",
      "remove": null
    }
  },
  "keywords": ["dsh", "usage", "cost", "subscription"],
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "react": "^18.3.1"
  }
}
